{
  "name": "Notification",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "type": {
      "type": "string",
      "title": "Notification Type",
      "enum": [
        "event_reminder",
        "payment_due",
        "subscription_expiring",
        "subscription_expired",
        "team_conflict",
        "general"
      ]
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "related_entity_type": {
      "type": "string",
      "title": "Related Entity Type"
    },
    "related_entity_id": {
      "type": "string",
      "title": "Related Entity ID"
    },
    "read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    }
  },
  "required": [
    "workspace_id",
    "user_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}