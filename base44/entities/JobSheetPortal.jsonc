{
  "name": "JobSheetPortal",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this portal belongs to"
    },
    "event_id": {
      "type": "string",
      "description": "Event this job sheet portal exposes publicly"
    },
    "public_token": {
      "type": "string",
      "description": "Secure random token used in the public crew URL. Not enumerable."
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master on/off switch. If false, the public URL shows an unavailable message and exposes no job sheet data."
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of valid portal openings by crew"
    },
    "first_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the first valid portal view"
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent valid portal view"
    }
  },
  "required": [
    "workspace_id",
    "event_id",
    "public_token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}