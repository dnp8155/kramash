{
  "name": "PaymentMilestone",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "quotation_id": {
      "type": "string",
      "title": "Source Quotation ID"
    },
    "event_id": {
      "type": "string",
      "title": "Event ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "name": {
      "type": "string",
      "title": "Milestone Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "milestone_type": {
      "type": "string",
      "title": "Milestone Type",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "milestone_value": {
      "type": "number",
      "title": "Milestone Value (% or fixed amount)",
      "default": 0
    },
    "due_amount": {
      "type": "number",
      "title": "Due Amount (calculated from quotation total)",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "title": "Paid Amount (from linked CLIENT_RECEIPT transactions)",
      "default": 0
    },
    "due_condition": {
      "type": "string",
      "title": "Due Condition (e.g. On signing, On event day, On handover)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date (if applicable)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "upcoming",
      "enum": [
        "upcoming",
        "due",
        "partially_paid",
        "paid",
        "overdue"
      ]
    },
    "financial_year_id": {
      "type": "string",
      "title": "Financial Year ID"
    }
  },
  "required": [
    "workspace_id",
    "quotation_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}