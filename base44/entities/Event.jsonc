{
  "name": "Event",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this event belongs to"
    },
    "client_id": {
      "type": "string",
      "description": "Client this event is for (normalized reference)"
    },
    "title": {
      "type": "string",
      "description": "Event title / name"
    },
    "event_type": {
      "type": "string",
      "description": "Type of event (Wedding, Corporate, etc.)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Event start date (date-only, YYYY-MM-DD)"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Event end date (date-only, YYYY-MM-DD). May be null for single-day events."
    },
    "venue": {
      "type": "string",
      "description": "Venue name"
    },
    "venue_address": {
      "type": "string",
      "description": "Full venue address"
    },
    "status": {
      "type": "string",
      "enum": [
        "Confirmed",
        "In Progress",
        "Pending",
        "Completed",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "contract_value": {
      "type": "number",
      "description": "Agreed event value \u2014 total the client is expected to pay. Source of truth for client pending calculation. May be set manually or synced from an approved quotation (Phase 6)."
    },
    "description": {
      "type": "string",
      "description": "Event description / brief"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "job_sheet_config": {
      "type": "object",
      "description": "Operational Job Sheet display configuration for crew execution. Controls what operational data is shown to crew/supervisors. Never contains financial data.",
      "properties": {
        "show_team_names": {
          "type": "boolean",
          "default": true,
          "description": "Show assigned member names alongside roles. If false, only role labels and counts are shown."
        },
        "include_contacts": {
          "type": "boolean",
          "default": false,
          "description": "Include crew contact directory with phone numbers."
        },
        "include_equipment": {
          "type": "boolean",
          "default": true,
          "description": "Include equipment / kit checklist section."
        },
        "equipment_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Custom equipment checklist items. Empty/null falls back to category-based defaults."
        },
        "default_reporting_time": {
          "type": "string",
          "description": "Default reporting time for all dates (e.g. 8:00 AM). Overridden by date_overrides."
        },
        "date_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "reporting_time": {
                "type": "string"
              },
              "venue": {
                "type": "string"
              }
            }
          },
          "description": "Per-date overrides for reporting time and venue."
        },
        "internal_notes": {
          "type": "string",
          "description": "Operational execution notes specific to the job sheet (distinct from general event notes)."
        }
      }
    }
  },
  "required": [
    "workspace_id",
    "client_id",
    "title",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}