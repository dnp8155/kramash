{
  "name": "Event",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "venue": {
      "type": "string",
      "title": "Venue"
    },
    "venue_address": {
      "type": "string",
      "title": "Venue Address"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "upcoming",
      "enum": [
        "upcoming",
        "in-progress",
        "completed",
        "cancelled"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "workspace_id",
    "client_id",
    "title",
    "start_date"
  ],
  "rls": {
    "read": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    },
    "create": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    },
    "update": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    },
    "delete": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    }
  }
}