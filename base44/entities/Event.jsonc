{
  "name": "Event",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "event_dates": {
      "type": "array",
      "title": "Event Dates (non-consecutive)",
      "items": {
        "type": "string",
        "format": "date"
      },
      "default": []
    },
    "team_member_ids": {
      "type": "array",
      "title": "Assigned Team Member IDs",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "service_ids": {
      "type": "array",
      "title": "Selected Service IDs",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "venue": {
      "type": "string",
      "title": "Venue"
    },
    "venue_address": {
      "type": "string",
      "title": "Venue Address"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "upcoming",
      "enum": [
        "upcoming",
        "in-progress",
        "completed",
        "cancelled"
      ]
    },
    "contract_value": {
      "type": "number",
      "title": "Contract / Agreed Value",
      "default": 0
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "workspace_id",
    "client_id",
    "title",
    "start_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}