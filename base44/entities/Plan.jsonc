{
  "name": "Plan",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Plan Code",
      "enum": [
        "FREE",
        "PRO"
      ]
    },
    "name": {
      "type": "string",
      "title": "Display Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}