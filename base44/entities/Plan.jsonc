{
  "name": "Plan",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "FREE",
        "PRO"
      ],
      "description": "Unique plan code"
    },
    "name": {
      "type": "string",
      "description": "Display name of the plan"
    },
    "description": {
      "type": "string",
      "description": "Short description shown on plan comparison"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this plan is available for assignment"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}