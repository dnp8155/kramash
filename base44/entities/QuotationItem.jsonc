{
  "name": "QuotationItem",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "quotation_id": {
      "type": "string",
      "title": "Quotation ID"
    },
    "item_type": {
      "type": "string",
      "title": "Item Type",
      "enum": [
        "service",
        "role",
        "custom"
      ]
    },
    "reference_id": {
      "type": "string",
      "title": "Reference ID"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity",
      "default": 1
    },
    "days": {
      "type": "number",
      "title": "Days",
      "default": 1
    },
    "unit_rate": {
      "type": "number",
      "title": "Unit Rate",
      "default": 0
    },
    "rate_type": {
      "type": "string",
      "title": "Rate Type",
      "default": "Fixed",
      "enum": [
        "Fixed",
        "Per Day",
        "Per Unit",
        "Per Event"
      ]
    },
    "line_total": {
      "type": "number",
      "title": "Line Total",
      "default": 0
    },
    "gst_rate": {
      "type": "number",
      "title": "GST Rate (%)",
      "default": 0
    },
    "sac_code": {
      "type": "string",
      "title": "SAC Code"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "workspace_id",
    "quotation_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}