{
  "name": "QuotationItem",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "quotation_id": {
      "type": "string",
      "title": "Quotation ID"
    },
    "item_type": {
      "type": "string",
      "title": "Item Type",
      "enum": [
        "service",
        "role",
        "team",
        "custom"
      ],
      "default": "custom"
    },
    "reference_id": {
      "type": "string",
      "title": "Reference ID (service_id, role_id, or team_member_id)"
    },
    "team_member_id": {
      "type": "string",
      "title": "Team Member ID (for team-type items)"
    },
    "team_member_name_snapshot": {
      "type": "string",
      "title": "Team Member Name Snapshot"
    },
    "member_type": {
      "type": "string",
      "title": "Member Type / Side (bride_side, groom_side, common, other)"
    },
    "day_date": {
      "type": "string",
      "format": "date",
      "title": "Day Date (which day/phase this item belongs to)"
    },
    "phase_title": {
      "type": "string",
      "title": "Function / Phase Title (e.g. Haldi, Sangeet, Site Measurement)"
    },
    "is_addon": {
      "type": "boolean",
      "title": "Is Add-on (last-minute service)",
      "default": false
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity",
      "default": 1
    },
    "days": {
      "type": "number",
      "title": "Days",
      "default": 1
    },
    "unit_rate": {
      "type": "number",
      "title": "Unit Rate",
      "default": 0
    },
    "rate_type": {
      "type": "string",
      "title": "Rate Type",
      "default": "Fixed",
      "enum": [
        "Fixed",
        "Per Day",
        "Per Unit",
        "Per Event"
      ]
    },
    "line_total": {
      "type": "number",
      "title": "Line Total",
      "default": 0
    },
    "gst_rate": {
      "type": "number",
      "title": "GST Rate (%)",
      "default": 0
    },
    "sac_code": {
      "type": "string",
      "title": "SAC Code"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "workspace_id",
    "quotation_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}