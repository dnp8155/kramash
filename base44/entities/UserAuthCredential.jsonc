{
  "name": "UserAuthCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "credential_id": {
      "type": "string",
      "title": "Credential ID (base64url)"
    },
    "public_key": {
      "type": "string",
      "title": "Public Key (JSON JWK string)"
    },
    "counter": {
      "type": "number",
      "title": "Signature Counter",
      "default": 0
    },
    "device_label": {
      "type": "string",
      "title": "Device Label"
    },
    "transports": {
      "type": "string",
      "title": "Transports (JSON array: internal, hybrid, usb, nfc, ble)"
    }
  },
  "required": [
    "user_id",
    "credential_id",
    "public_key"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}