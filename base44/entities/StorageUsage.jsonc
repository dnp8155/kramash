{
  "name": "StorageUsage",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "total_bytes": {
      "type": "number",
      "title": "Total Bytes Used",
      "default": 0
    },
    "file_count": {
      "type": "number",
      "title": "File Count",
      "default": 0
    }
  },
  "required": [
    "workspace_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}