{
  "name": "EventServiceAssignment",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this assignment belongs to"
    },
    "event_id": {
      "type": "string",
      "description": "Event this service is assigned to"
    },
    "service_id": {
      "type": "string",
      "description": "Service reference (from workspace Services master)"
    },
    "service_name_snapshot": {
      "type": "string",
      "description": "Service name snapshot for historical accuracy if the service is later renamed"
    },
    "provider_id": {
      "type": "string",
      "description": "Team member providing the service (optional)"
    },
    "provider_name_snapshot": {
      "type": "string",
      "description": "Provider name snapshot for historical accuracy"
    },
    "rate": {
      "type": "number",
      "description": "Event-specific rate for this service. Does NOT modify the master Service.default_rate."
    },
    "is_addon": {
      "type": "boolean",
      "default": false,
      "description": "If true, this service amount is added on top of the base contract value (last-minute add-on)"
    },
    "working_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Specific working dates selected from the event's date range. Null/empty means all event dates (backward compat)."
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "Assigned",
        "Removed"
      ],
      "default": "Assigned"
    }
  },
  "required": [
    "workspace_id",
    "event_id",
    "service_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}