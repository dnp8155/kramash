{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "phone": {
      "type": "string",
      "description": "User contact phone (E.164 format)"
    },
    "avatar": {
      "type": "string",
      "description": "URL to the user's avatar image"
    },
    "workspace_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of workspaces the user belongs to (multi-tenant scoping)"
    },
    "active_workspace_id": {
      "type": "string",
      "description": "Currently active workspace id for the user"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}