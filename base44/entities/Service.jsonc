{
  "name": "Service",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "name": {
      "type": "string",
      "title": "Service Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "default_rate": {
      "type": "number",
      "title": "Default Rate",
      "default": 0
    },
    "rate_type": {
      "type": "string",
      "title": "Rate Type",
      "default": "Fixed",
      "enum": [
        "Fixed",
        "Per Day",
        "Per Unit"
      ]
    },
    "gst_rate": {
      "type": "number",
      "title": "GST Rate (%)",
      "default": 0
    },
    "sac_code": {
      "type": "string",
      "title": "SAC Code"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "active",
      "enum": [
        "active",
        "inactive"
      ]
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    },
    "delete": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    }
  }
}