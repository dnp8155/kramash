{
  "name": "Service",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this service belongs to"
    },
    "name": {
      "type": "string",
      "description": "Service / deliverable name (e.g. Wedding Photography, Album)"
    },
    "description": {
      "type": "string",
      "description": "Optional service description shown on quotations"
    },
    "default_rate": {
      "type": "number",
      "default": 0,
      "description": "Default rate for this service in the workspace currency. Cannot be negative."
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "Fixed",
        "Per Day",
        "Per Unit",
        "Per Event"
      ],
      "default": "Fixed",
      "description": "How the default rate is charged"
    },
    "gst_rate": {
      "type": "number",
      "default": 0,
      "description": "Optional default GST rate percentage for this service (e.g. 18). Only used when workspace GST is enabled. Cannot be negative."
    },
    "sac_code": {
      "type": "string",
      "description": "Optional SAC (Services Accounting Code) for GST classification"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}