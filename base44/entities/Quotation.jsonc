{
  "name": "Quotation",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this quotation belongs to"
    },
    "quotation_number": {
      "type": "string",
      "description": "Unique workspace-level quotation number (e.g. QT-2026-0001)"
    },
    "client_id": {
      "type": "string",
      "description": "Existing client this quotation is for (null when using custom_client)"
    },
    "event_id": {
      "type": "string",
      "description": "Optional event this quotation is linked to"
    },
    "category": {
      "type": "string",
      "enum": [
        "PHOTOGRAPHY_VIDEOGRAPHY",
        "EVENT_MANAGEMENT",
        "ARCHITECTURE_INTERIOR",
        "OTHER"
      ],
      "default": "PHOTOGRAPHY_VIDEOGRAPHY",
      "description": "Quotation category \u2014 drives dynamic context fields (side vs property type)"
    },
    "context_side": {
      "type": "string",
      "description": "Event-side context for event categories (e.g. Bride Side, Groom Side, Common, Others)"
    },
    "property_type": {
      "type": "string",
      "description": "Property/project type for architecture/interior categories (e.g. Residential, Commercial, Office, Renovation, Interior, Other)"
    },
    "project_start_date": {
      "type": "string",
      "format": "date",
      "description": "Project/event start date (date-only, YYYY-MM-DD). Drives the date chip engine."
    },
    "project_end_date": {
      "type": "string",
      "format": "date",
      "description": "Project/event end date (date-only, YYYY-MM-DD). Null for single-day projects."
    },
    "excluded_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Dates within the project range that are excluded from the quotation scope"
    },
    "show_item_pricing": {
      "type": "boolean",
      "default": true,
      "description": "Controls client-facing pricing visibility. If false, Qty/Rate/Amount are hidden in PDF and public URL. Admin always retains full data."
    },
    "custom_client": {
      "type": "object",
      "description": "Custom client details when no existing Client is selected (does not create a master Client record)",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        }
      }
    },
    "quotation_date": {
      "type": "string",
      "format": "date",
      "description": "Quotation date (date-only, YYYY-MM-DD)"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Optional validity date (date-only, YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Finalized",
        "Accepted",
        "Rejected"
      ],
      "default": "Draft"
    },
    "subtotal": {
      "type": "number",
      "description": "Sum of all line item totals"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "default": "percentage"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount value (percentage or fixed amount)"
    },
    "discount_amount": {
      "type": "number",
      "description": "Computed discount amount in currency"
    },
    "taxable_amount": {
      "type": "number",
      "description": "Subtotal minus discount"
    },
    "gst_applicable": {
      "type": "boolean",
      "default": false,
      "description": "Whether GST is applied to this quotation"
    },
    "gst_mode": {
      "type": "string",
      "enum": [
        "cgst_sgst",
        "igst"
      ],
      "default": "cgst_sgst"
    },
    "cgst_amount": {
      "type": "number",
      "description": "CGST amount (same-state)"
    },
    "sgst_amount": {
      "type": "number",
      "description": "SGST amount (same-state)"
    },
    "igst_amount": {
      "type": "number",
      "description": "IGST amount (inter-state)"
    },
    "gst_total": {
      "type": "number",
      "description": "Total GST amount"
    },
    "grand_total": {
      "type": "number",
      "description": "Final total payable (taxable + GST)"
    },
    "terms_and_conditions": {
      "type": "string",
      "description": "Quotation terms and conditions text"
    },
    "special_notes": {
      "type": "string",
      "description": "Scope-specific notes (travel, accommodation, revision limits, client requirements)"
    },
    "notes": {
      "type": "string",
      "description": "Optional internal notes"
    },
    "client_snapshot": {
      "type": "object",
      "description": "Snapshot of client details at finalization for historical accuracy",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "business_snapshot": {
      "type": "object",
      "description": "Snapshot of workspace/business details at finalization for historical accuracy",
      "properties": {
        "name": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "gst_business_name": {
          "type": "string"
        },
        "gstin": {
          "type": "string"
        },
        "gst_billing_address": {
          "type": "string"
        },
        "gst_state": {
          "type": "string"
        }
      }
    },
    "event_snapshot": {
      "type": "object",
      "description": "Snapshot of event details at finalization for historical accuracy",
      "properties": {
        "title": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "venue_address": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "workspace_id",
    "quotation_number",
    "quotation_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}