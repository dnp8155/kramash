{
  "name": "ProjectFile",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "event_id": {
      "type": "string",
      "title": "Event / Project ID"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "file_type": {
      "type": "string",
      "title": "File Type",
      "default": "document",
      "enum": [
        "contract",
        "brief",
        "reference",
        "deliverable",
        "document",
        "image",
        "video",
        "other"
      ]
    },
    "file_size": {
      "type": "number",
      "title": "File Size (bytes)",
      "default": 0
    },
    "mime_type": {
      "type": "string",
      "title": "MIME Type"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "uploaded_by_name": {
      "type": "string",
      "title": "Uploaded By (name snapshot)"
    },
    "is_private": {
      "type": "boolean",
      "title": "Private (internal only)",
      "default": false
    }
  },
  "required": [
    "workspace_id",
    "event_id",
    "file_name",
    "file_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}