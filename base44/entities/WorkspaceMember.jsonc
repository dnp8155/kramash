{
  "name": "WorkspaceMember",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this membership belongs to"
    },
    "workspace_owner_id": {
      "type": "string",
      "description": "Owner user id of the workspace (denormalized for access control)"
    },
    "user_id": {
      "type": "string",
      "description": "User that is a member"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "accountant",
        "manager",
        "staff"
      ],
      "default": "owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "invited",
        "removed"
      ],
      "default": "active"
    }
  },
  "required": [
    "workspace_id",
    "user_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.workspace_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.workspace_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}