{
  "name": "Lead",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "name": {
      "type": "string",
      "title": "Contact Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "company": {
      "type": "string",
      "title": "Company / Organization"
    },
    "source": {
      "type": "string",
      "title": "Lead Source",
      "default": "direct",
      "enum": [
        "instagram",
        "meta_ads",
        "whatsapp",
        "referral",
        "website",
        "phone_call",
        "direct",
        "other"
      ]
    },
    "stage": {
      "type": "string",
      "title": "Pipeline Stage",
      "default": "new",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "proposal_sent",
        "won",
        "lost"
      ]
    },
    "work_type": {
      "type": "string",
      "title": "Work / Event Type Interest"
    },
    "budget": {
      "type": "number",
      "title": "Budget",
      "default": 0
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "title": "Tentative Event Date"
    },
    "venue": {
      "type": "string",
      "title": "Venue"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (Team Member ID)"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ]
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "title": "Next Follow-up Date"
    },
    "converted_client_id": {
      "type": "string",
      "title": "Converted To Client ID"
    },
    "converted_event_id": {
      "type": "string",
      "title": "Converted To Event ID"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Converted At"
    },
    "lost_reason": {
      "type": "string",
      "title": "Lost Reason"
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}