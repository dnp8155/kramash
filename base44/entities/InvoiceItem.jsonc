{
  "name": "InvoiceItem",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "invoice_id": {
      "type": "string",
      "title": "Invoice ID"
    },
    "item_type": {
      "type": "string",
      "title": "Item Type",
      "default": "line_item",
      "enum": [
        "package",
        "line_item"
      ]
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity",
      "default": 1
    },
    "unit_rate": {
      "type": "number",
      "title": "Unit Rate",
      "default": 0
    },
    "line_total": {
      "type": "number",
      "title": "Line Total",
      "default": 0
    },
    "events_json": {
      "type": "string",
      "title": "Nested Events (JSON array for package type)"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "workspace_id",
    "invoice_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}