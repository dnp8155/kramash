{
  "name": "PlanPricing",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "title": "Plan ID"
    },
    "billing_cycle": {
      "type": "string",
      "title": "Billing Cycle",
      "enum": [
        "MONTHLY",
        "SIX_MONTHS",
        "ANNUAL"
      ]
    },
    "price": {
      "type": "number",
      "title": "Price",
      "default": 0
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "INR"
    },
    "duration_months": {
      "type": "number",
      "title": "Duration (months)",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "plan_id",
    "billing_cycle",
    "price",
    "duration_months"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}