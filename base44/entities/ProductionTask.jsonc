{
  "name": "ProductionTask",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "event_id": {
      "type": "string",
      "title": "Event / Project ID"
    },
    "title": {
      "type": "string",
      "title": "Task Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "task_type": {
      "type": "string",
      "title": "Task Type",
      "default": "editing",
      "enum": [
        "raw_selection",
        "editing",
        "color_grading",
        "review",
        "album_design",
        "delivery",
        "revision",
        "other"
      ]
    },
    "stage": {
      "type": "string",
      "title": "Stage",
      "default": "pending",
      "enum": [
        "pending",
        "in_progress",
        "review",
        "delivered",
        "on_hold"
      ]
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (Team Member ID)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ]
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "workspace_id",
    "event_id",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}