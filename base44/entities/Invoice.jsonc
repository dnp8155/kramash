{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number"
    },
    "quotation_id": {
      "type": "string",
      "title": "Source Quotation ID (optional)"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "event_id": {
      "type": "string",
      "title": "Event ID"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "title": "Invoice Date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "due_date_type": {
      "type": "string",
      "title": "Due Date Type",
      "default": "due_on_receipt",
      "enum": [
        "due_on_receipt",
        "net_15",
        "net_30",
        "custom"
      ]
    },
    "invoice_type": {
      "type": "string",
      "title": "Invoice Type",
      "default": "manual",
      "enum": [
        "full",
        "milestone",
        "manual"
      ]
    },
    "milestone_id": {
      "type": "string",
      "title": "Payment Milestone ID (for milestone-type invoices)"
    },
    "milestone_tag": {
      "type": "string",
      "title": "Milestone Tag",
      "default": "Full Payment",
      "enum": [
        "Advance",
        "Event Day",
        "Final Handover",
        "Full Payment",
        "Custom"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "draft",
      "enum": [
        "draft",
        "due",
        "sent",
        "paid",
        "partial",
        "overdue",
        "cancelled"
      ]
    },
    "show_itemized_rates": {
      "type": "boolean",
      "title": "Show Itemized Rates on PDF & Public Link",
      "default": true
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "discount_type": {
      "type": "string",
      "title": "Discount Type",
      "default": "percent",
      "enum": [
        "percent",
        "fixed"
      ]
    },
    "discount_value": {
      "type": "number",
      "title": "Discount Value",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount Amount",
      "default": 0
    },
    "taxable_amount": {
      "type": "number",
      "title": "Taxable Amount",
      "default": 0
    },
    "gst_applicable": {
      "type": "boolean",
      "title": "GST Applicable",
      "default": false
    },
    "gst_rate": {
      "type": "number",
      "title": "GST Rate (%)",
      "default": 0
    },
    "gst_mode": {
      "type": "string",
      "title": "GST Mode",
      "default": "cgst_sgst",
      "enum": [
        "cgst_sgst",
        "igst"
      ]
    },
    "cgst_amount": {
      "type": "number",
      "title": "CGST Amount",
      "default": 0
    },
    "sgst_amount": {
      "type": "number",
      "title": "SGST Amount",
      "default": 0
    },
    "igst_amount": {
      "type": "number",
      "title": "IGST Amount",
      "default": 0
    },
    "gst_total": {
      "type": "number",
      "title": "GST Total",
      "default": 0
    },
    "grand_total": {
      "type": "number",
      "title": "Grand Total",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "title": "Amount Paid",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "title": "Balance Due",
      "default": 0
    },
    "amount_in_words": {
      "type": "string",
      "title": "Total Amount in Words"
    },
    "payment_schedule_json": {
      "type": "string",
      "title": "Payment Schedule (JSON)"
    },
    "client_snapshot": {
      "type": "string",
      "title": "Client Snapshot (JSON)"
    },
    "business_snapshot": {
      "type": "string",
      "title": "Business Snapshot (JSON)"
    },
    "event_snapshot": {
      "type": "string",
      "title": "Event Snapshot (JSON)"
    },
    "bank_details_snapshot": {
      "type": "string",
      "title": "Bank & UPI Details Snapshot (JSON)"
    },
    "social_links_snapshot": {
      "type": "string",
      "title": "Social Links Snapshot (JSON)"
    },
    "authorized_signatory": {
      "type": "string",
      "title": "Authorized Signatory Name"
    },
    "notes": {
      "type": "string",
      "title": "Internal Notes (never shown to client)"
    },
    "payment_terms": {
      "type": "string",
      "title": "Payment Terms (client-visible)"
    },
    "terms_and_conditions": {
      "type": "string",
      "title": "Terms & Conditions (client-visible)"
    },
    "public_token": {
      "type": "string",
      "title": "Public Invoice Token (secure random token for public URL)"
    },
    "public_link_enabled": {
      "type": "boolean",
      "title": "Public Link Enabled (admin master control)",
      "default": false
    },
    "portal_view_count": {
      "type": "number",
      "title": "Portal View Count",
      "default": 0
    },
    "portal_first_viewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Portal First Viewed At"
    },
    "portal_latest_viewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Portal Latest Viewed At"
    }
  },
  "required": [
    "workspace_id",
    "invoice_number",
    "invoice_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}