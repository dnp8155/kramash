{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this invoice belongs to"
    },
    "invoice_number": {
      "type": "string",
      "description": "INV-YYYY-XXXX format, workspace-specific, auto-generated, immutable"
    },
    "quotation_id": {
      "type": "string",
      "description": "Optional quotation this invoice was created from"
    },
    "client_id": {
      "type": "string",
      "description": "Client this invoice is for"
    },
    "event_id": {
      "type": "string",
      "description": "Optional event/project this invoice is linked to"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Invoice issue date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Calculated from due_date_type or custom date"
    },
    "due_date_type": {
      "type": "string",
      "enum": [
        "due_on_receipt",
        "net_15",
        "net_30",
        "custom"
      ],
      "default": "due_on_receipt"
    },
    "invoice_type": {
      "type": "string",
      "enum": [
        "full",
        "milestone",
        "manual"
      ],
      "default": "manual"
    },
    "milestone_index": {
      "type": "number",
      "description": "Index of the quotation milestone this invoice covers (for milestone invoices). Null for non-milestone invoices."
    },
    "milestone_tag": {
      "type": "string",
      "enum": [
        "Advance",
        "Event Day",
        "Final Handover",
        "Full Payment",
        "Custom"
      ],
      "description": "Label for milestone invoices"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Due",
        "Partially Paid",
        "Paid",
        "Overdue",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "show_itemized_rates": {
      "type": "boolean",
      "default": true,
      "description": "Controls client-facing pricing visibility. If false, Qty/Rate/individual line amounts are hidden in PDF and public URL."
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "deliverables": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_rate": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      },
      "description": "Invoice line items (snapshot at creation time)"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "flat"
      ],
      "default": "percentage"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount value (percentage or flat amount)"
    },
    "subtotal": {
      "type": "number",
      "description": "Sum of all line item totals"
    },
    "discount_amount": {
      "type": "number",
      "description": "Computed discount amount"
    },
    "taxable_amount": {
      "type": "number",
      "description": "Subtotal minus discount"
    },
    "tax_enabled": {
      "type": "boolean",
      "default": false
    },
    "tax_rate": {
      "type": "number",
      "description": "GST rate percentage (e.g. 18)"
    },
    "tax_mode": {
      "type": "string",
      "enum": [
        "CGST_SGST",
        "IGST"
      ],
      "default": "CGST_SGST"
    },
    "cgst_amount": {
      "type": "number"
    },
    "sgst_amount": {
      "type": "number"
    },
    "igst_amount": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number",
      "description": "Total tax amount (CGST+SGST or IGST)"
    },
    "total_amount": {
      "type": "number",
      "description": "Final invoice total (taxable + tax)"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Sum of all valid payment transactions linked to this invoice"
    },
    "balance_due": {
      "type": "number",
      "description": "total_amount - amount_paid"
    },
    "amount_in_words": {
      "type": "string",
      "description": "Total amount in words (e.g. 'Rupees Ten Thousand Only')"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes \u2014 never shown on public invoice or PDF"
    },
    "payment_terms": {
      "type": "string",
      "description": "Client-visible payment terms shown on PDF and public URL"
    },
    "client_snapshot": {
      "type": "object",
      "description": "Snapshot of client billing details at issuance",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "gstin": {
          "type": "string"
        }
      }
    },
    "business_snapshot": {
      "type": "object",
      "description": "Snapshot of business details at issuance",
      "properties": {
        "name": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "gstin": {
          "type": "string"
        },
        "gst_business_name": {
          "type": "string"
        },
        "gst_billing_address": {
          "type": "string"
        },
        "gst_state": {
          "type": "string"
        }
      }
    },
    "event_snapshot": {
      "type": "object",
      "description": "Snapshot of event details at issuance",
      "properties": {
        "title": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "venue": {
          "type": "string"
        },
        "venue_address": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        }
      }
    },
    "bank_snapshot": {
      "type": "object",
      "description": "Snapshot of bank/UPI details at issuance",
      "properties": {
        "bank_account_name": {
          "type": "string"
        },
        "bank_name": {
          "type": "string"
        },
        "bank_account_number": {
          "type": "string"
        },
        "bank_ifsc": {
          "type": "string"
        },
        "bank_upi_id": {
          "type": "string"
        }
      }
    },
    "public_access_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master on/off switch for public invoice URL"
    },
    "public_token": {
      "type": "string",
      "description": "Secure random token for public invoice URL. Not enumerable."
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "first_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "invoice_number",
    "client_id",
    "issue_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}