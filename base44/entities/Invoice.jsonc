{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number"
    },
    "quotation_id": {
      "type": "string",
      "title": "Source Quotation ID (optional)"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "event_id": {
      "type": "string",
      "title": "Event ID"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "title": "Invoice Date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "draft",
      "enum": [
        "draft",
        "sent",
        "paid",
        "partial",
        "cancelled"
      ]
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "discount_type": {
      "type": "string",
      "title": "Discount Type",
      "default": "percent",
      "enum": [
        "percent",
        "fixed"
      ]
    },
    "discount_value": {
      "type": "number",
      "title": "Discount Value",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount Amount",
      "default": 0
    },
    "taxable_amount": {
      "type": "number",
      "title": "Taxable Amount",
      "default": 0
    },
    "gst_applicable": {
      "type": "boolean",
      "title": "GST Applicable",
      "default": false
    },
    "gst_mode": {
      "type": "string",
      "title": "GST Mode",
      "default": "cgst_sgst",
      "enum": [
        "cgst_sgst",
        "igst"
      ]
    },
    "cgst_amount": {
      "type": "number",
      "title": "CGST Amount",
      "default": 0
    },
    "sgst_amount": {
      "type": "number",
      "title": "SGST Amount",
      "default": 0
    },
    "igst_amount": {
      "type": "number",
      "title": "IGST Amount",
      "default": 0
    },
    "gst_total": {
      "type": "number",
      "title": "GST Total",
      "default": 0
    },
    "grand_total": {
      "type": "number",
      "title": "Grand Total",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "title": "Amount Paid",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "title": "Balance Due",
      "default": 0
    },
    "payment_schedule_json": {
      "type": "string",
      "title": "Payment Schedule (JSON)"
    },
    "client_snapshot": {
      "type": "string",
      "title": "Client Snapshot (JSON)"
    },
    "business_snapshot": {
      "type": "string",
      "title": "Business Snapshot (JSON)"
    },
    "event_snapshot": {
      "type": "string",
      "title": "Event Snapshot (JSON)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "terms_and_conditions": {
      "type": "string",
      "title": "Terms & Conditions"
    }
  },
  "required": [
    "workspace_id",
    "invoice_number",
    "invoice_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}