{
  "name": "LeadActivity",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "activity_type": {
      "type": "string",
      "title": "Activity Type",
      "default": "note",
      "enum": [
        "call",
        "whatsapp",
        "email",
        "meeting",
        "note",
        "stage_change",
        "follow_up"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "old_stage": {
      "type": "string",
      "title": "Previous Stage (for stage_change)"
    },
    "new_stage": {
      "type": "string",
      "title": "New Stage (for stage_change)"
    }
  },
  "required": [
    "workspace_id",
    "lead_id",
    "activity_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}