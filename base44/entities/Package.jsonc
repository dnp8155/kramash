{
  "name": "Package",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "name": {
      "type": "string",
      "title": "Package Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "default": "general",
      "enum": [
        "wedding",
        "pre_wedding",
        "event",
        "corporate",
        "portrait",
        "general"
      ]
    },
    "items_json": {
      "type": "string",
      "title": "Items (JSON array of {service_id, name, quantity, unit_rate, rate_type})"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "discount_type": {
      "type": "string",
      "title": "Discount Type",
      "default": "percent",
      "enum": [
        "percent",
        "fixed"
      ]
    },
    "discount_value": {
      "type": "number",
      "title": "Discount Value",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount Amount",
      "default": 0
    },
    "total_price": {
      "type": "number",
      "title": "Total Price (after discount)",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}